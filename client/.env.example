# Copy the variables you need into .env.development (git-ignored) and fill them in.

# Dev server only: the backend's address. Vite forwards API requests there.
# It has no VITE_ prefix, so it is never included in the browser bundle.
API_PROXY_TARGET=

# Optional: the full API base URL, for when the API runs on another origin.
# Leave it unset to use the same origin (the dev proxy).
# VITE_API_BASE_URL=

# Optional: show prices in a currency, as an ISO code such as USD or EUR.
# Leave it unset to show plain numbers with 2 decimals.
# VITE_CURRENCY=
